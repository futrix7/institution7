# ============================================
# TNGC — environment template
# ============================================
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#
# Anything marked SERVER ONLY must never be prefixed with NEXT_PUBLIC_ — those
# variables are inlined into the JavaScript bundle and are readable by anyone
# who loads the page.

# ---------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------
# NEXT_PUBLIC_ variables are safe to expose: they identify the project, and
# access is governed by the RLS policies in supabase.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely, so it can read and write every table and
# every auth user. Required by the rate limiter, password reset, and both
# registration routes.
#
# Rotating this invalidates nothing at rest but is the single highest-value
# credential in the project. If it has ever been pasted into a chat, a log, or a
# commit, rotate it in the dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Admin registration
# ---------------------------------------------------------------
# SERVER ONLY. The invite code required by /api/admin/register. It is the ONLY
# way to create an admin account — there is no self-service or OAuth path.
#
# While this is unset, /api/admin/register returns 503 and no admin can be
# created. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_REG_CODE=

# ---------------------------------------------------------------
# Finance PIN gate — /admin/finanace
# ---------------------------------------------------------------
# SERVER ONLY. The second factor in front of the finance dashboard.
#
# LIMITATION, stated plainly: this is a single shared 6-digit value in this file,
# identical for every administrator, stored in plaintext and not hashed. It is
# not a second factor in the strict sense — there is no per-admin secret to
# steal, revoke, or rotate independently. What protects it today is that
# /api/verify-pin verifies a real admin session first and allows only 5 attempts
# per admin per 15 minutes.
#
# The right fix is a per-admin hashed PIN in a table with its own settings UI.
# Until that exists, treat this value as a speed bump, not a control, and rotate
# it whenever an admin leaves.
FINANCE_PIN=

# ---------------------------------------------------------------
# UPI payment details — shown on the registration form
# ---------------------------------------------------------------
# NEXT_PUBLIC_ because the QR code is rendered in the browser. These are public
# by nature: anyone can see them to pay you.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=
